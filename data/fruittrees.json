  "rules": {
    "days_to_mature": {
      "value": 28,
      "evidence": "Fruit Trees require 28 days to mature, after which they produce one fruit per day when in season."
    },
    "fruit_per_day": {
      "value": 1,
      "evidence": "produce one fruit per day when in season"
    },
    "max_on_tree": {
      "value": 3,
      "evidence": "Fruit can accumulate up to three days before harvesting."
    },
    "no_water_no_winter_death": {
      "value": true,
      "evidence": "Fruit trees do not need to be watered, and will not die in the winter."
    },
    "grows_any_season": {
      "value": true,
      "evidence": "Fruit saplings will grow during any season, allowing players to plant and prepare for upcoming seasons to bear fruit."
    },
    "clear_area": {
      "value": 3,
      "evidence": "Each Fruit tree must be planted in the center of a clear 3x3 ground area"
    },
    "greenhouse_and_island_every_day": {
      "value": true,
      "evidence": "Fruit trees planted in the greenhouse or on Ginger Island bear fruit every day after maturity"
    },
    "greenhouse_border": {
      "value": true,
      "evidence": "Fruit trees can grow in the Greenhouse , in the center soil or around the border."
    },
    "quality_per_year": {
      "value": {
        "silver": 1,
        "gold": 2,
        "iridium": 3
      },
      "evidence": "Fruit trees will produce silver star fruit after one year, gold after two years, and iridium after three."
    },
    "sapling_quality_speed": {
      "value": {
        "silver": 2,
        "gold": 3,
        "iridium": 5
      },
      "evidence": "a silver sapling grows 2 times faster, a gold sapling grows 3 times faster, and an iridium sapling grows 5 times faster"
    },
    "chop_for_sapling": {
      "value": true,
      "evidence": "Fruit trees can be chopped down, yielding normal wood and a matching sapling of the same quality as the fruit."
    },
    "tiller_and_artisan": {
      "value": true,
      "evidence": "Fruit Tree fruit receives the Tiller Profession price bonus when sold, and jelly , wine , or dried fruits made from fruit tree fruit receives the Artisan Profession price bonus when sold."
    },
    "lightning_days": {
      "value": 4,
      "evidence": "causing them to become burnt for 4 days"
    },
    "weather_proof": {
      "value": true,
      "evidence": "Fruit trees will not be affected by weather"
    },
    "all_saplings_pierre": {
      "value": 25400,
      "evidence": "A complete set of all six fruit tree saplings costs a total of 25,400g if purchased from Pierre's General Store"
    }
  },
